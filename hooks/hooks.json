{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/describe.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/describe.py" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/describe.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/describe.py" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/describe.py || python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/describe.py" }]
      }
    ]
  }
}
