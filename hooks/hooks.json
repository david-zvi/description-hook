{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "in=$(cat); printf '%s' \"$in\" | python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject_rules.py || printf '%s' \"$in\" | python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject_rules.py" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "in=$(cat); printf '%s' \"$in\" | python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject_rules.py || printf '%s' \"$in\" | python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/inject_rules.py" }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "in=$(cat); printf '%s' \"$in\" | python3 \"${CLAUDE_PLUGIN_ROOT}\"/hooks/require_description.py || printf '%s' \"$in\" | python \"${CLAUDE_PLUGIN_ROOT}\"/hooks/require_description.py" }]
      }
    ]
  }
}
